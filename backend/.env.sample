# Riot Games API Configuration
# Get your API key at: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Region cluster for Account-V1 & Match-V5 (e.g., asia, americas, europe)
RIOT_API_REGION=asia

# Platform routing for Summoner-V4 & League-V4 (e.g., jp1, kr, na1)
RIOT_API_PLATFORM=jp1
